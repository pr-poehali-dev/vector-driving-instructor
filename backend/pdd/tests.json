{
  "tests": [
    {
      "name": "OPTIONS returns 200",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Get categories public",
      "method": "POST",
      "path": "/",
      "body": { "action": "get_categories" },
      "expectedStatus": 200
    },
    {
      "name": "Unknown action returns 400",
      "method": "POST",
      "path": "/",
      "body": { "action": "not_a_real_action" },
      "expectedStatus": 400
    },
    {
      "name": "Start test without auth returns 401",
      "method": "POST",
      "path": "/",
      "body": { "action": "start_test", "test_type": "random" },
      "expectedStatus": 401
    },
    {
      "name": "Get all categories no token forbidden",
      "method": "POST",
      "path": "/",
      "body": { "action": "get_all_categories" },
      "expectedStatus": 403
    }
  ]
}