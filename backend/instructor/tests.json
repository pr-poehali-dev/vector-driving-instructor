{
  "tests": [
    {
      "name": "OPTIONS returns 200",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Login missing fields",
      "method": "POST",
      "path": "/",
      "body": { "action": "login" },
      "expectedStatus": 400,
      "expectedBody": { "error": "string" },
      "bodyMatcher": "partial"
    },
    {
      "name": "Login wrong credentials",
      "method": "POST",
      "path": "/",
      "body": { "action": "login", "login": "nouser", "password": "wrong" },
      "expectedStatus": 401
    },
    {
      "name": "Me without token",
      "method": "POST",
      "path": "/",
      "body": { "action": "me" },
      "expectedStatus": 401
    },
    {
      "name": "Get kpi without auth",
      "method": "POST",
      "path": "/",
      "body": { "action": "get_kpi" },
      "expectedStatus": 401
    },
    {
      "name": "Unknown action",
      "method": "POST",
      "path": "/",
      "body": { "action": "not_a_real_action" },
      "expectedStatus": 400
    }
  ]
}
