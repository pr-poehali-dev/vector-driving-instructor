{
  "tests": [
    {
      "name": "OPTIONS returns 200",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Get dashboard without auth returns 401",
      "method": "POST",
      "path": "/",
      "body": { "action": "get_dashboard" },
      "expectedStatus": 401
    },
    {
      "name": "Unknown action returns 400",
      "method": "POST",
      "path": "/",
      "body": { "action": "not_a_real_action" },
      "expectedStatus": 400
    },
    {
      "name": "Notifications list no token forbidden",
      "method": "POST",
      "path": "/",
      "body": { "action": "notifications-list" },
      "expectedStatus": 403
    }
  ]
}
